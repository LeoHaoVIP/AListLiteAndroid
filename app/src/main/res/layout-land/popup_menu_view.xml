<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏 / 电视：两列网格，8 项一屏放得下
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:fitsSystemWindows="true">

    <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/popup_menu_border"
            android:elevation="8dp">

        <TextView
                android:id="@+id/menu_section_service"
                style="@style/PopupMenuSectionHeader"
                android:layout_width="0dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:paddingTop="4dp"
                android:paddingBottom="0dp"
                android:text="服务"/>

        <TextView
                android:id="@+id/btn_showQrCode"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_qrcode"
                android:text="@string/popup_menu_item_qrcode"/>

        <TextView
                android:id="@+id/btn_openInBrowser"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_browser"
                android:text="@string/popup_menu_item_open_browser"/>

        <TextView
                android:id="@+id/btn_serviceLogs"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_logs"
                android:text="@string/popup_menu_item_service_logs"/>

        <TextView
                style="@style/PopupMenuSectionHeader"
                android:layout_width="0dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:paddingTop="8dp"
                android:paddingBottom="0dp"
                android:text="安全"/>

        <TextView
                android:id="@+id/btn_oneClickLogin"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_login"
                android:text="@string/popup_menu_item_one_click_login"/>

        <TextView
                android:id="@+id/btn_setAdminPassword"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_key"
                android:text="@string/popup_menu_item_password"/>

        <TextView
                android:id="@+id/btn_toggleHttps"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_shortcut_https"
                android:text="@string/popup_menu_item_https"/>

        <TextView
                style="@style/PopupMenuSectionHeader"
                android:layout_width="0dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:paddingTop="8dp"
                android:paddingBottom="0dp"
                android:text="更多"/>

        <TextView
                android:id="@+id/btn_showAliTvTokenGetPage"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_cloud"
                android:text="@string/popup_menu_item_alitv_token_get"/>

        <TextView
                android:id="@+id/btn_checkUpdates"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/refresh"
                android:text="@string/popup_menu_item_check_updates"/>

        <TextView
                android:id="@+id/btn_settings"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_config"
                android:text="@string/popup_menu_item_settings"/>

        <TextView
                android:id="@+id/btn_showSystemInfo"
                style="@style/PopupMenuItemGrid"
                android:drawableStart="@drawable/ic_menu_info"
                android:text="@string/popup_menu_item_about"/>
    </GridLayout>
</FrameLayout>
