<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background">

    <TextView
        android:id="@+id/diag_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/activity_title_storage_diagnostic"
        android:textSize="18sp"
        android:textColor="@color/ios_text_primary"
        android:fontFamily="sans-serif-medium"/>

    <ScrollView
        android:id="@+id/diag_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/diag_title"
        android:layout_above="@id/btn_diag_refresh">

        <LinearLayout
            android:id="@+id/diag_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"/>
    </ScrollView>

    <Button
        android:id="@+id/btn_diag_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:text="重新检测"
        android:textAllCaps="false"/>
</RelativeLayout>
